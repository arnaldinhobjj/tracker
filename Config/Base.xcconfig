// Shared build settings for DayLedger.
//
// Do NOT put real values here. Copy Config/Local.example.xcconfig to Config/Local.xcconfig
// (git-ignored) and fill in your own IDs there; it overrides the defaults below.

// Bundle identifier of the app. The widget uses "$(DL_BUNDLE_ID).widget".
DL_BUNDLE_ID = com.example.dayledger
// App Group shared by the app and the widget. Must be registered in your Apple Developer account.
DL_APP_GROUP_ID = group.$(DL_BUNDLE_ID)
// Your Apple Developer Team ID (needed to run on a device).
DL_DEVELOPMENT_TEAM =

// TrueLayer (https://console.truelayer.com). "sandbox" or "live".
TRUELAYER_ENVIRONMENT = sandbox
TRUELAYER_CLIENT_ID =
// Optional, Debug builds only: lets a Debug build talk to the TrueLayer sandbox without a backend.
// Leave empty to use the `truelayer-token` Edge Function (the only option in Release builds;
// Config/Release.xcconfig blanks this value).
TRUELAYER_CLIENT_SECRET =

// Google Cloud OAuth client of type "iOS", e.g. 1234-abcd.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID =

// DayLedger backend (Supabase): accounts, DayLedger Pro and the TrueLayer token exchange. Leave
// empty to run local-only: the app works without accounts, and banks can only be connected in
// Debug builds with TRUELAYER_CLIENT_SECRET set.
// Write URLs as https:/$()/xyz.supabase.co because "//" starts a comment in .xcconfig files.
SUPABASE_URL =
// The project's anon (public) key. Public by design: row-level security protects the data.
SUPABASE_ANON_KEY =

// Links shown on the paywall (required by App Review for subscriptions). Same https:/$()/ trick.
DL_TERMS_URL =
DL_PRIVACY_URL =

#include? "Local.xcconfig"
